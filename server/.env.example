NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/carerooster
# At least 32 characters. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN_HOURS=8
# Origin of the Next.js client (CORS allow-list)
CLIENT_ORIGIN=http://localhost:3000

# Used only by `npm run seed`
SEED_ADMIN_EMAIL=admin@carerooster.dev
SEED_ADMIN_PASSWORD=Admin@12345
