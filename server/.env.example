# Template for server/.env. CI fills the $PLACEHOLDERS with envsubst (see docs/deployment.md);
# locally, copy this file to .env and replace each one, e.g. MONGO_URI=mongodb://localhost:27017/carerooster
NODE_ENV=$NODE_ENV
PORT=$PORT

# Database
MONGO_URI=$MONGO_URI

# At least 32 characters. Generate one: openssl rand -hex 32
JWT_SECRET=$JWT_SECRET
JWT_EXPIRES_IN_HOURS=$JWT_EXPIRES_IN_HOURS

# Origin of the Next.js client (CORS allow-list)
CLIENT_ORIGIN=$CLIENT_ORIGIN
# Proxy hops in front of the API (0 = none, 1 = nginx, 2 = Vercel rewrite + nginx)
TRUST_PROXY=$TRUST_PROXY
